{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Register",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9À-ÿ-_\\s]+$"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string",
      "minLength": 13
    }
  },
  "required": ["name", "email", "password"]
}